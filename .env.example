DATABASE_URL=postgresql://postgres.[project-ref]:[database-password]@[pooler-host]:6543/postgres
# Optional CA certificate from Supabase Database Settings > SSL Configuration.
# SUPABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DB_POOL_MAX=3
PORT=3000
INITIAL_SETUP_TOKEN=replace-with-a-random-secret-at-least-32-characters
